{
  "name": "@radialapps/memories-vips-editor",
  "version": "0.1.6",
  "description": "Headless WebGL preview library for vips-static edits. Renders an ordered edit list on a caller-provided canvas; serializes the same list as JSON for the vips-preview CLI (convert/thumbnail ... \"edits\": [...]).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:lib": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "parity": "python3 demo/generate-parity.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build:lib",
    "publish:dry": "npm publish --dry-run",
    "format": "prettier --write src demo tests *.json *.md",
    "format:check": "prettier --check src demo tests *.json *.md"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
